{
  "name": "wedevelopnl/silverstripe-grid",
  "description": "Grid-based content block system for SilverStripe",
  "type": "silverstripe-vendormodule",
  "license": "BSD-3-Clause",
  "homepage": "https://wedevelop.nl",
  "keywords": [
    "silverstripe",
    "content blocks",
    "grid",
    "layout"
  ],
  "authors": [
    {
      "name": "WeDevelop",
      "email": "development@wedevelop.nl"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "silverstripe/admin": "^3.0",
    "silverstripe/cms": "^6.0",
    "silverstripe/framework": "^6.0",
    "silverstripe/vendor-plugin": "^3.0",
    "silverstripe/versioned": "^3.0"
  },
  "conflict": {
    "dnadesign/silverstripe-elemental": "*"
  },
  "extra": {
    "expose": [
      "client/dist",
      "client/images",
      "client/lang",
      "lang"
    ]
  },
  "require-dev": {
    "cambis/silverstan": "^2.1",
    "infection/infection": "^0.32",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpunit/phpunit": "^11.3",
    "tomasvotruba/type-coverage": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "WeDevelop\\Grid\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WeDevelop\\Grid\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
