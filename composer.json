{
  "name": "wedevelopnl/silverstripe-elemental-grid",
  "description": "Elemental grid module",
  "type": "silverstripe-vendormodule",
  "license": "BSD-3-Clause",
  "homepage": "https://wedevelop.nl",
  "keywords": [
    "silverstripe",
    "element",
    "elemental",
    "content blocks",
    "grid"
  ],
  "authors": [
    {
      "name": "WeDevelop",
      "email": "development@wedevelop.nl"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "dnadesign/silverstripe-elemental": "^6.0",
    "silverstripe/admin": "^3.0",
    "silverstripe/framework": "^6.0",
    "silverstripe/vendor-plugin": "^3.0"
  },
  "conflict": {
    "dnadesign/silverstripe-elemental-list": "*"
  },
  "extra": {
    "expose": [
      "client/dist",
      "client/images",
      "client/lang",
      "lang"
    ]
  },
  "autoload": {
    "psr-4": {
      "WeDevelop\\ElementalGrid\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
