{
  "name": "@wedevelopnl/silverstripe-elemental-grid",
  "version": "6.0.0",
  "description": "Elemental grid module for SilverStripe",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint client/src && stylelint 'client/src/**/*.scss'",
    "lint:js": "eslint client/src",
    "lint:js:fix": "eslint client/src --fix",
    "lint:css": "stylelint 'client/src/**/*.scss'",
    "lint:css:fix": "stylelint 'client/src/**/*.scss' --fix",
    "qa": "npm run lint && npm run typecheck && npm run test",
    "mutate": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.5.0",
    "@stryker-mutator/typescript-checker": "^9.5.0",
    "@stryker-mutator/vitest-runner": "^9.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^26.0.0",
    "sass-embedded": "^1.77.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
