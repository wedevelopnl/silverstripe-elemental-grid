{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["/module/src"]
    },
    "timeout": 30,
    "logs": {
        "text": "infection/infection.log",
        "json": "infection/infection.json"
    },
    "mutators": {
        "@default": true,
        "CastInt": {
            "ignore": [
                "WeDevelop\\ElementalGrid\\Forms\\GridEditorField::getSchemaDataDefaults",
                "WeDevelop\\ElementalGrid\\Controllers\\ElementalGridController::apiReadTree"
            ]
        }
    },
    "minMsi": 0,
    "minCoveredMsi": 0
}
