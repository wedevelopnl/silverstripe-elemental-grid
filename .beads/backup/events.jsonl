{"actor":"Erik Frèrejean","comment":null,"created_at":"2026-03-03T10:50:20Z","event_type":"status_changed","id":146,"issue_id":"weg-6ub","new_value":"{\"status\":\"in_progress\"}","old_value":"{\"id\":\"weg-6ub\",\"title\":\"Use proper HTTP methods for ElementalGridController routes\",\"description\":\"Update mutation endpoints to use semantically correct HTTP methods: PATCH for state changes (publish, unpublish, reorder), DELETE for removals, POST for resource creation.\",\"status\":\"open\",\"priority\":2,\"issue_type\":\"task\",\"owner\":\"erik@wedevelop.nl\",\"created_at\":\"2026-03-03T09:50:15Z\",\"created_by\":\"Erik Frèrejean\",\"updated_at\":\"2026-03-03T09:50:15Z\"}"}
